# Copia este archivo a ".env" y llena los valores desde
# Firebase Console -> Configuración del proyecto -> Tus apps -> SDK setup.
# Nunca subas el archivo ".env" real a GitHub (ya está en .gitignore).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: URL del script de notificaciones por correo (ver notificaciones/README.md).
# Si la dejas vacía, la app funciona igual, solo que sin enviar avisos por correo.
VITE_NOTIFICACIONES_URL=

# Opcional: clave de reCAPTCHA v3 para App Check (ver README.md, sección
# "Protección contra pedidos falsos"). Si la dejas vacía, la app funciona
# igual, solo que sin esa capa extra de protección contra bots/spam.
VITE_RECAPTCHA_SITE_KEY=
