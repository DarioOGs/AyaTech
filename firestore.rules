rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return estaAutenticado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    match /especies/{especieId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /pedidos/{pedidoId} {
      allow create: if true;
      allow read, update, delete: if esAdmin();
    }

    match /auditoria/{entradaId} {
      allow read: if esAdmin();
      allow create: if esAdmin();
      allow update, delete: if false;
    }

    match /ventas/{ventaId} {
      allow read, create: if esAdmin();
      allow update, delete: if false;
    }

    match /clientesBloqueados/{cedula} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /usuarios/{uid} {
      allow read, write: if esAdmin();
    }

    match /configuracion/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }
  }
}
